# Copy this file to deploy/.env and change what you need. Every value below is the default,
# so an empty or missing deploy/.env deploys the UI against a local mcp-document-service.
# Environment variables take precedence over this file.

# Host the UI proxies /api/v1 to. host.docker.internal is the machine running Docker,
# which is where mcp-document-service publishes its port.
API_HOST=host.docker.internal

# Port of mcp-document-service on that host.
API_PORT=55535

# Host address and port the UI is published on.
UI_BIND_ADDRESS=0.0.0.0
UI_PORT=5431

# Names of the built image and the container. The image tag is the package.json version.
UI_IMAGE=document-service-ui
UI_CONTAINER_NAME=document-service-ui
